{
  "datasets": [
    {
      "name": "7f7fdd01",
      "displayName": "monthly_summary",
      "queryLines": [
        "SELECT month, income, net_spend, savings, round(savings_rate * 100, 1) AS savings_rate_pct\r\n",
        "FROM workspace.finance_pipeline.gold_monthly_summary\r\n",
        "ORDER BY month"
      ],
      "catalog": "workspace",
      "schema": "finance_pipeline"
    },
    {
      "name": "801ed3cf",
      "displayName": "category_spend",
      "queryLines": [
        "SELECT month, category, spent\r\n",
        "FROM workspace.finance_pipeline.gold_category_spend"
      ]
    },
    {
      "name": "5ffcf34e",
      "displayName": "budget_this_month",
      "queryLines": [
        "SELECT category, monthly_budget, spent, remaining, round(pct_used * 100, 1) AS pct_used, status\r\n",
        "FROM workspace.finance_pipeline.gold_budget_status\r\n",
        "WHERE month = (SELECT max(month) FROM workspace.finance_pipeline.gold_budget_status)\r\n",
        "ORDER BY pct_used DESC"
      ],
      "catalog": "workspace",
      "schema": "finance_pipeline"
    },
    {
      "name": "3550bcd8",
      "displayName": "transaction",
      "queryLines": [
        "SELECT txn_date, month, merchant, category, amount, account\r\n",
        "FROM workspace.finance_pipeline.transactions_categorized\r\n",
        "WHERE direction = 'DEBIT' AND category <> 'Transfer'"
      ],
      "catalog": "workspace",
      "schema": "finance_pipeline"
    },
    {
      "name": "106381f5",
      "displayName": "data_quality",
      "queryLines": [
        "SELECT\r\n",
        "  (SELECT count(*) FROM workspace.finance_pipeline.silver_transactions)     AS clean_transactions,\r\n",
        "  (SELECT count(*) FROM workspace.finance_pipeline.quarantine_transactions) AS quarantined_rows"
      ]
    }
  ],
